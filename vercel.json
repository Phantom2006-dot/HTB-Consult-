{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-sitemap"
    },
    {
      "source": "/course/:id",
      "destination": "/api/seo-course?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "https://htbconsult.fly.dev/api/:path*"
    },
    {
      "source": "/",
      "destination": "/api/seo-page?path=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/seo-page?path=/:path*"
    }
  ]
}
